#!/bin/sh

set -eu

printf '%s\n' 'Running mandatory CodeRabbit pre-commit review...'

if ! command -v coderabbit >/dev/null 2>&1; then
    printf '%s\n' 'Commit blocked: CodeRabbit CLI is not installed.' >&2
    printf '%s\n' 'Install it from https://www.coderabbit.ai/cli and try again.' >&2
    exit 1
fi

if ! coderabbit auth status >/dev/null 2>&1; then
    printf '%s\n' 'Commit blocked: CodeRabbit CLI is not authenticated.' >&2
    printf '%s\n' 'Run: coderabbit auth login' >&2
    exit 1
fi

# Exclude this hook because the scanner expressions below intentionally contain
# credential-shaped examples and would otherwise match their own source code.
if git diff --cached --no-ext-diff --unified=0 -- . ':(exclude).githooks/pre-commit' | grep -Eiq '(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|pdl_(live|sdbx)_apikey_|re_[A-Za-z0-9_-]{20,}|AWS_SECRET_ACCESS_KEY|GITHUB_TOKEN[[:space:]]*=)'; then
    printf '%s\n' 'Commit blocked: staged changes may contain a credential or private key.' >&2
    printf '%s\n' 'Remove the secret from the staged diff before sending code to CodeRabbit.' >&2
    exit 1
fi

if ! coderabbit review --agent -t uncommitted; then
    printf '%s\n' 'Commit blocked: CodeRabbit review did not complete successfully.' >&2
    exit 1
fi

printf '%s\n' 'CodeRabbit review completed. Continuing commit.'
