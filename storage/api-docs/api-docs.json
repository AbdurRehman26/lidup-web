{
    "openapi": "3.0.0",
    "info": {
        "title": "LidUp API",
        "description": "Validate LidUp license keys, manage Mac device activations, report completed tasks, and check for app updates.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Current LidUp application"
        }
    ],
    "paths": {
        "/activation/verify": {
            "post": {
                "tags": [
                    "Activation"
                ],
                "summary": "Activate or verify a Mac",
                "operationId": "verifyActivation",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "device_id"
                                ],
                                "properties": {
                                    "device_id": {
                                        "type": "string",
                                        "example": "macbook-pro-hardware-id",
                                        "maxLength": 191
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "Work MacBook Pro",
                                        "nullable": true,
                                        "maxLength": 120
                                    },
                                    "app_version": {
                                        "type": "string",
                                        "example": "1.2.0",
                                        "nullable": true,
                                        "maxLength": 40
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The Mac is activated and the entitlement is valid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "valid": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "activation_id": {
                                            "type": "integer",
                                            "example": 42
                                        },
                                        "plan": {
                                            "type": "string",
                                            "example": "personal"
                                        },
                                        "subscription_status": {
                                            "type": "string",
                                            "example": "active"
                                        },
                                        "entitlement_source": {
                                            "type": "string",
                                            "enum": [
                                                "subscription",
                                                "trial"
                                            ]
                                        },
                                        "entitled_until": {
                                            "type": "string",
                                            "format": "date-time",
                                            "nullable": true
                                        },
                                        "device_limit": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "active_devices": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The activation key is missing or invalid."
                    },
                    "403": {
                        "description": "The entitlement is inactive or the key lacks permission."
                    },
                    "409": {
                        "description": "The package device limit has been reached."
                    },
                    "422": {
                        "description": "The device details are invalid."
                    }
                },
                "security": [
                    {
                        "licenseKey": []
                    }
                ]
            }
        },
        "/activation/{deviceId}": {
            "delete": {
                "tags": [
                    "Activation"
                ],
                "summary": "Deactivate a Mac",
                "operationId": "deactivateDevice",
                "parameters": [
                    {
                        "name": "deviceId",
                        "in": "path",
                        "description": "The device identifier originally used during activation.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "macbook-pro-hardware-id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The Mac was deactivated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "deactivated": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "device_id": {
                                            "type": "string",
                                            "example": "macbook-pro-hardware-id"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The activation key is missing or invalid."
                    },
                    "403": {
                        "description": "The key cannot deactivate devices."
                    },
                    "404": {
                        "description": "No active device matches the identifier."
                    }
                },
                "security": [
                    {
                        "licenseKey": []
                    }
                ]
            }
        },
        "/license/validate": {
            "get": {
                "tags": [
                    "License"
                ],
                "summary": "Validate a license key",
                "description": "Returns the current paid or trial entitlement without activating a device.",
                "operationId": "validateLicense",
                "responses": {
                    "200": {
                        "description": "The license is active.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "valid": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "reason": {
                                            "type": "string",
                                            "example": null,
                                            "nullable": true
                                        },
                                        "plan": {
                                            "type": "string",
                                            "example": "personal",
                                            "nullable": true
                                        },
                                        "subscription_status": {
                                            "type": "string",
                                            "example": "trialing"
                                        },
                                        "entitlement_source": {
                                            "type": "string",
                                            "example": "trial",
                                            "enum": [
                                                "subscription",
                                                "trial"
                                            ]
                                        },
                                        "entitled_until": {
                                            "type": "string",
                                            "format": "date-time",
                                            "nullable": true
                                        },
                                        "device_limit": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "active_devices": {
                                            "type": "integer",
                                            "example": 0
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The activation key is missing or invalid."
                    },
                    "403": {
                        "description": "The key lacks permission or its entitlement is inactive."
                    }
                },
                "security": [
                    {
                        "licenseKey": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "License"
                ],
                "summary": "Validate a license key using POST",
                "description": "POST-compatible version of license validation for native clients.",
                "operationId": "validateLicensePost",
                "responses": {
                    "200": {
                        "description": "The license is active."
                    },
                    "401": {
                        "description": "The activation key is missing or invalid."
                    },
                    "403": {
                        "description": "The key lacks permission or its entitlement is inactive."
                    }
                },
                "security": [
                    {
                        "licenseKey": []
                    }
                ]
            }
        },
        "/releases/latest": {
            "get": {
                "tags": [
                    "Releases"
                ],
                "summary": "Get the latest macOS release",
                "description": "Returns public update metadata for the latest published LidUp build. No account or activation key is required.",
                "operationId": "getLatestRelease",
                "responses": {
                    "200": {
                        "description": "The latest published release metadata.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "version",
                                        "minimum_os",
                                        "release_notes",
                                        "published_at",
                                        "download_url",
                                        "available"
                                    ],
                                    "properties": {
                                        "version": {
                                            "type": "string",
                                            "example": "1.2.0"
                                        },
                                        "minimum_os": {
                                            "type": "string",
                                            "example": "macOS 14 Sonoma"
                                        },
                                        "release_notes": {
                                            "type": "string",
                                            "example": "Update checking and reliability improvements.",
                                            "nullable": true
                                        },
                                        "published_at": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2026-08-01T10:30:00+00:00",
                                            "nullable": true
                                        },
                                        "download_url": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": "https://lidup.app/download/latest"
                                        },
                                        "available": {
                                            "description": "Whether the installer currently exists in release storage.",
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No published current release exists."
                    },
                    "429": {
                        "description": "Too many update checks."
                    }
                }
            }
        },
        "/webhooks/task-completed": {
            "post": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Report a completed task",
                "description": "Stores a terminal task event and emails the owner of the activation key. Reusing an event_id is idempotent and never sends a duplicate email.",
                "operationId": "taskCompletedWebhook",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "event_id",
                                    "status",
                                    "summary"
                                ],
                                "properties": {
                                    "event_id": {
                                        "type": "string",
                                        "example": "evt_01JZ8F7KQJ3N4D6M8P2R"
                                    },
                                    "task_id": {
                                        "type": "string",
                                        "example": "codex-task-184",
                                        "nullable": true
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "completed",
                                        "enum": [
                                            "completed",
                                            "failed",
                                            "cancelled"
                                        ]
                                    },
                                    "summary": {
                                        "type": "string",
                                        "example": "Production build and test suite completed successfully."
                                    },
                                    "duration_seconds": {
                                        "type": "integer",
                                        "example": 754,
                                        "nullable": true,
                                        "minimum": 0
                                    },
                                    "device_id": {
                                        "type": "string",
                                        "example": "macbook-pro-hardware-id",
                                        "nullable": true
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "Work MacBook Pro",
                                        "nullable": true
                                    },
                                    "completed_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    },
                                    "details": {
                                        "type": "object",
                                        "example": {
                                            "agent": "Codex",
                                            "tests": 25,
                                            "branch": "main"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "The event was stored and the email was sent."
                    },
                    "200": {
                        "description": "The event was already processed; no duplicate email was sent."
                    },
                    "401": {
                        "description": "The activation key is missing or invalid."
                    },
                    "403": {
                        "description": "The activation key cannot submit task events."
                    },
                    "422": {
                        "description": "The payload is invalid."
                    }
                },
                "security": [
                    {
                        "licenseKey": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "licenseKey": {
                "type": "http",
                "description": "Use the complete activation key generated for the user.",
                "bearerFormat": "LidUp activation key",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "License",
            "description": "License entitlement validation"
        },
        {
            "name": "Activation",
            "description": "Mac device activation management"
        },
        {
            "name": "Tasks",
            "description": "Task completion notifications"
        },
        {
            "name": "Releases",
            "description": "Public macOS app update metadata"
        }
    ]
}